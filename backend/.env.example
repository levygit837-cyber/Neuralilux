# Backend Environment Variables

# Project
PROJECT_NAME=Neuralilux
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg://neuralilux:neuralilux_password@localhost:5434/neuralilux

# Redis
REDIS_URL=redis://:redis_password@localhost:6380/0

# Evolution API
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=change-me-in-production
# Token do webhook (ADR 0006): a Evolution chama /api/v1/webhooks/evolution?token=<este valor>.
# Deixe vazio em dev só se não for receber webhooks; sem ele toda chamada recebe 401, e com ENVIRONMENT != development
# a app recusa subir sem um token real. Gere um: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_WEBHOOK_TOKEN=
# Senha do usuário `evolution` no Postgres. Lida pelo docker-compose (entra na URI do banco da Evolution) e por
# scripts/init-multiple-databases.sh; o backend não a usa. O valor tem de ser URL-safe: só letras, dígitos, `-` e `_`
# (caracteres como @ : / ? # % quebram a URI). Vazio: vale o default de desenvolvimento do compose e do script.
# O init só roda na primeira criação do volume do Postgres; num banco existente use ALTER USER evolution.
EVOLUTION_DB_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://neuralilux:rabbitmq_password@localhost:5672/neuralilux

# JWT Authentication
SECRET_KEY=change-me-in-production-use-strong-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gateway local "Kiro-backend" (semeado por scripts/seed_data.py na primeira execução;
# depois é editado em Configurações > Gateways). A chave é opcional e fica criptografada no banco.
# Dentro de containers, localhost não alcança o host: use http://host.docker.internal:5580
KIRO_GATEWAY_URL=http://localhost:5580
# KIRO_GATEWAY_API_KEY=

# CORS Origins (JSON array format)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Tool telemetry
TOOL_EVENT_PREVIEW_LIMIT=240
TOOL_EVENT_INCLUDE_RAW_PAYLOADS=false
