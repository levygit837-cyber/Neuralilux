# Backend Environment Variables

# Project
PROJECT_NAME=Neuralilux
VERSION=0.1.0
# Sem ENVIRONMENT=development explícito a app trata o ambiente como produção: recusa subir com os valores de
# exemplo deste arquivo (SECRET_KEY, EVOLUTION_WEBHOOK_TOKEN, GATEWAY_ENCRYPTION_KEY) e esconde /docs e /redoc.
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg://neuralilux:neuralilux_password@localhost:5434/neuralilux

# Redis
REDIS_URL=redis://:redis_password@localhost:6380/0
# Timeouts do cliente Redis do event bus (segundos) e health check (segundos entre PINGs de conexão ociosa).
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Teto que um evento de UI pode segurar o Turn; depois de falhar, os eventos seguintes são descartados pelo cooldown.
# O cooldown precisa ser MAIOR que o teto, senão a app recusa subir.
REALTIME_PUBLISH_TIMEOUT_SECONDS=1
REALTIME_PUBLISH_COOLDOWN_SECONDS=5

# Evolution API
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=change-me-in-production
# Token do webhook (ADR 0006): a Evolution chama /api/v1/webhooks/evolution?token=<este valor>.
# Deixe vazio em dev só se não for receber webhooks; sem ele toda chamada recebe 401, e com ENVIRONMENT != development
# a app recusa subir sem um token real. Gere um: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_WEBHOOK_TOKEN=
# Senha do usuário `evolution` no Postgres. Lida pelo docker-compose (entra na URI do banco da Evolution) e por
# scripts/init-multiple-databases.sh; o backend não a usa. O valor tem de ser URL-safe: só letras, dígitos, `-` e `_`
# (caracteres como @ : / ? # % quebram a URI). Vazio: vale o default de desenvolvimento do compose e do script.
# O init só roda na primeira criação do volume do Postgres; num banco existente use ALTER USER evolution.
EVOLUTION_DB_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://neuralilux:rabbitmq_password@localhost:5672/neuralilux

# JWT Authentication
# Só assina o JWT. Gere uma: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-strong-secret-key-minimum-32-characters
# Criptografa as chaves de API dos Gateways no banco; independente da SECRET_KEY (rotacionar o JWT não as afeta).
# Obrigatória, com 32+ caracteres e diferente da SECRET_KEY fora de development (a SECRET_KEY também exige 32+). Trocá-la invalida as chaves salvas.
# Ao atualizar um banco com Gateways já salvos, defina uma chave REAL antes do scripts/reencrypt_gateway_secrets.py:
# o script recusa a de exemplo (veja docs/operations.md).
# Gere uma: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_ENCRYPTION_KEY=change-me-dev-only-gateway-encryption-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gateway local "Kiro-backend" (semeado por scripts/seed_data.py na primeira execução;
# depois é editado em Configurações > Gateways). A chave é opcional e fica criptografada no banco.
# Dentro de containers, localhost não alcança o host: use http://host.docker.internal:5580
KIRO_GATEWAY_URL=http://localhost:5580
# KIRO_GATEWAY_API_KEY=

# CORS Origins (JSON array format)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Tool telemetry
TOOL_EVENT_PREVIEW_LIMIT=240
TOOL_EVENT_INCLUDE_RAW_PAYLOADS=false

# Agrupamento de Messages picadas: pausa (segundos) do Contact antes do Turn do Agent. 0 desliga o agrupamento.
DEBOUNCE_SECONDS=3
# "Digitando" no WhatsApp: a presença expira sozinha, então é renovada a cada tantos segundos enquanto o Turn roda.
TYPING_REFRESH_SECONDS=20

# Worker: mensagens processadas em paralelo por consumer e intervalo da varredura que expira Handoffs sem Attendant.
RABBITMQ_PREFETCH=8
HANDOFF_SWEEP_INTERVAL_SECONDS=60
