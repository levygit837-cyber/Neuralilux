# Frontend Environment Variables

# O frontend só fala com o backend (Bearer). Nenhuma chave da Evolution vai para o navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Opcional: sem ele, o Socket.IO usa o mesmo host de NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Environment
NEXT_PUBLIC_ENVIRONMENT=development
