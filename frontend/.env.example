# Frontend Environment Variables

# O frontend só fala com o backend. A sessão é um cookie httpOnly gravado pela API (ADR 0008); nenhuma chave da
# Evolution nem token de sessão vai para o JavaScript do navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Opcional: sem ele, o Socket.IO usa o mesmo host de NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Opcional: URL com que o servidor do Next alcança a API para validar a sessão (/auth/me), quando difere da do navegador
# (ex.: http://api:8000 na rede do Docker). Sem ele vale NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:8000
# Só se o backend usar AUTH_COOKIE_DOMAIN (cookie de domínio pai): o mesmo valor aqui, para o proxy apagar o cookie recusado.
# AUTH_COOKIE_DOMAIN=.exemplo.com

# Environment
NEXT_PUBLIC_ENVIRONMENT=development
